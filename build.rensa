PROJECT_NAME rensa
PROJECT_VERSION 1.0.0

// This is a test base

TARGET RS{PROJECT_NAME}
  VARS
    CXX = /usr/bin/g++
    CXX_INCLUDES = -Iinclude
    CXX_FLAGS = -std=c++23 -Wall -Wextra RS{CXX_INCLUDES}
    CXX_LD_FLAGS = 

    SRC_DIR = src/
    INCLUDE_DIR = 
  END

  DEPENDENCIES
    FILES_RECURSIVE_IN RS{SRC_DIR} cpp
    FILES_RECURSIVE_IN RS{INCLUDE_DIR} hpp 
  END

  USE_BUILDER rensa-cpp
END
